{
  "name": "mini-nest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/src/server.js\"",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "nodemon": "3.1.9",
    "typescript": "6.0.3"
  }
}
